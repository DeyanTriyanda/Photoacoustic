{
  "configurations": [
    {
      "name": "Win32",
      "includePath": [
        "${workspaceFolder}/native/include",
        "${workspaceFolder}/native/third_party/kissfft",
        "${workspaceFolder}/.venv/Lib/site-packages/pybind11/include",
        "${workspaceFolder}/venv/Lib/site-packages/pybind11/include",
        "${env:LOCALAPPDATA}/Programs/Python/Python312/Lib/site-packages/pybind11/include",
        "${env:LOCALAPPDATA}/Programs/Python/Python311/Lib/site-packages/pybind11/include",
        "${env:USERPROFILE}/AppData/Roaming/Python/Python312/site-packages/pybind11/include",
        "${env:USERPROFILE}/AppData/Roaming/Python/Python311/site-packages/pybind11/include"
      ],
      "defines": [
        "_WIN32",
        "WIN32",
        "_USE_MATH_DEFINES",
        "kiss_fft_scalar=double"
      ],
      "windowsSdkVersion": "10.0.22621.0",
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-msvc-x64",
      "browse": {
        "path": [
          "${workspaceFolder}/native"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/native/include",
        "${workspaceFolder}/native/third_party/kissfft",
        "/usr/include",
        "${workspaceFolder}/.venv/lib/python3.12/site-packages/pybind11/include",
        "${workspaceFolder}/.venv/lib/python3.11/site-packages/pybind11/include"
      ],
      "defines": ["kiss_fft_scalar=double"],
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
